{
  "Jwt": {
    "Secret": "your-super-secret-key-change-this-in-production-at-least-32-characters",
    "Issuer": "StudySummarizer",
    "Audience": "StudySummarizerAPI"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=studysummarizer.db"
  },
  "Swagger": {
    "Title": "Document Management API v1",
    "RoutePrefix": "api/v1"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/app-.txt", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}
